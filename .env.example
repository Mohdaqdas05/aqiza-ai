# Copy this file to .env for local development.
DATABASE_URL="file:./prisma/dev.db"
# Set DATABASE_AUTH_TOKEN when using a managed libSQL/Turso database.
DATABASE_AUTH_TOKEN=""

# Add at least one provider key. These keys are read only by server routes.
GOOGLE_GENERATIVE_AI_API_KEY=""
GROQ_API_KEY=""
OPENROUTER_API_KEY=""

# Generate a unique 32-byte secret before using OAuth sign-in or deploying.
AUTH_SECRET=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# Optional: leave blank to auto-detect Ollama on this computer.
# Set a custom OpenAI-compatible Ollama URL only when needed.
OLLAMA_BASE_URL=""
OLLAMA_API_KEY="ollama"

# Chat is guest-owned in local development. Before public deployment, configure
# Google and/or GitHub OAuth, keep guest access disabled, and use a durable database.
ALLOW_GUEST_CHAT="false"

# Required for chat in production; local development uses an in-process limiter.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
